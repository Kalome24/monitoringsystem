# Server Configuration
PORT=5000

# Database Configuration for SQL Server
DB_HOST=localhost
DB_USER=sa
DB_PASSWORD=Password1
DB_NAME=imd_monitoring
DB_PORT=1433

# JWT Secret - CHANGE THIS to a strong secret
JWT_SECRET=your_super_secret_jwt_key_change_this_to_a_strong_random_string

# JWT lifetime — how long a login stays valid
# Examples: 8h, 12h, 24h, 7d
JWT_EXPIRES_IN=24h

# Bcrypt Salt Rounds
BCRYPT_SALT_ROUNDS=10

EMAIL="shalom.mendoza@lepantomining.com"
EMAIL_PASSWORD="sm2014#26"
EMAIL_HOST="lmd.lepantomining.com"

# ---------------------------------------------------------------------------
# Cross-DB Underground Sync (Session 16)
# ---------------------------------------------------------------------------
# Two-machine topology
#   • Surface server (receives pushes):
#       IMS_SYNC_ACCEPT_KEY=<long-random-secret>
#       SURFACE_BASE_URL and SURFACE_SYNC_KEY stay empty.
#   • Underground server (sends pushes):
#       SURFACE_BASE_URL=http://<surface-host>:5000
#       SURFACE_SYNC_KEY=<same-secret-as-IMS_SYNC_ACCEPT_KEY>
#       IMS_SYNC_ACCEPT_KEY stays empty.
#
# Same-machine loopback test: leave everything empty here and override per
# terminal with $env:PORT / $env:SURFACE_BASE_URL / $env:SURFACE_SYNC_KEY
# / $env:IMS_SYNC_ACCEPT_KEY — dotenv does NOT override shell env vars.
#
# If SURFACE_BASE_URL AND SURFACE_SYNC_KEY are BOTH empty on a server, the
# legacy shared-DB behaviour is used. Nothing breaks.

# Surface side — shared secret this server accepts on
# POST /api/underground/receive-online-sync.
IMS_SYNC_ACCEPT_KEY=

# Underground side — where to push, and with what key.
SURFACE_BASE_URL=
SURFACE_SYNC_KEY=

# Optional: how long to wait for the surface to respond (ms). Default 15000.
IMS_SYNC_TIMEOUT_MS=15000

# Optional: label this server in log lines ("UG-01", "SURFACE-CWH1", etc.).
IMS_SERVER_ID=

# ---------------------------------------------------------------------------
# Session 16 — Cross-DB peer identity (underground servers ONLY)
# ---------------------------------------------------------------------------
# Every standalone underground server must set these so the surface can
# tell them apart. On the surface server, leave them all empty.

# Unique server id — used as the primary key in dbo.sync_peers.
# Format suggestion: <WAREHOUSE>-SRV-NN — e.g. "UG-SRV-01", "LUMB-SRV-02".
IMS_DISPLAY_NAME=

# Warehouse code this server serves. MUST be 'UG' or 'LUMB'.
# (Same code as the underground_shift.warehouse_code for shifts opened here.)
IMS_WAREHOUSE_CODE=

# ---------------------------------------------------------------------------
# Session 16 — Peer registry (SURFACE servers ONLY)
# ---------------------------------------------------------------------------
# The surface needs one entry per known peer so it can reach them for pull.
# Convention: PEER_<SERVER_ID_UPPERCASE_UNDERSCORES>_URL=http://host:port
#
# Examples:
#   PEER_UG_SRV_01_URL=http://ug-srv-01.local:5001
#   PEER_UG_SRV_02_URL=http://ug-srv-02.local:5001
#   PEER_LUMB_SRV_01_URL=http://lumb-srv-01.local:5001
#
# Optional template fallback (used only if a per-peer var is missing,
# useful for single-machine loopback testing):
PEER_BASE_URL=

# Secret the surface presents when calling a peer's remote-export endpoints.
# MUST match the peer's IMS_SYNC_ACCEPT_KEY.
UNDERGROUND_SYNC_KEY=